-----------------------------------------------------------------
-- 【分頁 2：內置功能】內容
-----------------------------------------------------------------

local RunService = game:GetService("RunService")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- 3. 獨立穿牆 (No-Clip) 開關
local NoClipConnection = nil
UtilityTab:CreateToggle({
    Name = "開啟/關閉 穿牆 (No-Clip)",
    CurrentValue = false,
    Flag = "ToggleNoClip",
    Callback = function(Value)
        if Value then
            NoClipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
            Rayfield:Notify({Title = "穿牆開啟", Content = "已忽略所有物理碰撞", Duration = 2})
        else
            if NoClipConnection then
                NoClipConnection:Disconnect()
                NoClipConnection = nil
            end
            Rayfield:Notify({Title = "穿牆關閉", Content = "恢復正常物理碰撞", Duration = 2})
        end
    end,
})

-- 4. 平滑飛行 (Smooth Fly) 開關與速度滑桿
local FlyConnection = nil
local FlySpeedValue = 50

UtilityTab:CreateToggle({
    Name = "開啟/關閉 平滑飛行 (Smooth Fly)",
    CurrentValue = false,
    Flag = "ToggleSmoothFly",
    Callback = function(Value)
        if Value then
            FlyConnection = RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if root and humanoid then
                        humanoid.PlatformStand = true
                        local cam = workspace.CurrentCamera
                        local moveDir = humanoid.MoveDirection
                        
                        if moveDir.Magnitude > 0 then
                            local camLook = cam.CFrame.LookVector
                            local camRight = cam.CFrame.RightVector
                            
                            local flatLook = Vector3.new(camLook.X, 0, camLook.Unit.Z)
                            local flatRight = Vector3.new(camRight.X, 0, camRight.Unit.Z)
                            
                            local moveVector = (flatLook * moveDir.Z + flatRight * moveDir.X).Unit
                            if moveVector.Magnitude > 0 then
                                root.Velocity = moveVector * FlySpeedValue + Vector3.new(0, 0, 0)
                            else
                                root.Velocity = Vector3.new(0, 0, 0)
                            end
                        else
                            root.Velocity = Vector3.new(0, 0, 0)
                        end
                    end
                end
            end)
            Rayfield:Notify({Title = "飛行開啟", Content = "平滑飛行引擎啟動", Duration = 2})
        else
            if FlyConnection then FlyConnection:Disconnect() end
            local char = LocalPlayer.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                if humanoid then humanoid.PlatformStand = false end
                if root then root.Velocity = Vector3.new(0, 0, 0) end
            end
            Rayfield:Notify({Title = "飛行關閉", Content = "已安全降落並恢復重力", Duration = 2})
        end
    end,
})

UtilityTab:CreateSlider({
    Name = "飛行速度調節",
    Range = {10, 200},
    Increment = 5,
    CurrentValue = 50,
    Flag = "FlySpeedSlider",
    Callback = function(Value)
        FlySpeedValue = Value
    end,
})

